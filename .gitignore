# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*

# Build
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testes e cobertura
/coverage

# Ambiente - nenhuma chave vai para o Git
.env
.env*.local
.env.production

# Vercel
.vercel

# Sistema operacional e editores
.DS_Store
*.pem
/.idea
/.vscode/*
!/.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Estado local do CLI do Supabase (referência do projeto, chaves de sessão)
supabase/.temp

# Chave de assinatura do Android.
#
# Perder este arquivo significa nunca mais conseguir ATUALIZAR o aplicativo
# publicado: o Google identifica a atualizacao pela assinatura, e uma chave
# nova e tratada como outro aplicativo. Versiona-la e pior ainda — quem tiver o
# repositorio consegue publicar em nome do dono.
celular/android/key.properties
celular/android/app/*.jks
celular/android/app/*.keystore
