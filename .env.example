# =============================================================================
# Tronvix Facil - variaveis de ambiente
#
# Copie este arquivo para .env.local e preencha. O .env.local nao vai para o
# Git: nenhuma chave deste projeto pode ser versionada.
#
# Regra que vale para tudo aqui: o prefixo NEXT_PUBLIC_ significa "vai para o
# navegador". Uma chave secreta com esse prefixo e uma chave publicada.
# =============================================================================

# --- Supabase (obrigatorio) --------------------------------------------------
# Painel do Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico: IGNORA A RLS POR COMPLETO. So o servidor usa (webhook de
# pagamento, criacao de login de funcionario, rotinas administrativas).
# Nunca leva NEXT_PUBLIC_ e nunca e importada por componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Token pessoal do CLI, usado por `npm run db:aplicar`.
# Painel do Supabase -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=

# --- Aplicacao ---------------------------------------------------------------
NEXT_PUBLIC_URL_DO_SITE=http://localhost:3000
NEXT_PUBLIC_NOME_DA_MARCA=Tronvix Fácil

# --- Pagamentos (Etapa 2) ----------------------------------------------------
# Enquanto vazio, o adaptador simulado assume: gera QR Code de Pix ficticio e
# confirma o pagamento apos alguns segundos. A troca pelo provedor real e feita
# preenchendo estas variaveis, sem tocar na regra de negocio.
PAGAMENTO_PROVEDOR=simulado
PAGAMENTO_CHAVE_API=
PAGAMENTO_SEGREDO_DO_WEBHOOK=

# --- Integracao com o TronvixERP (futuro) ------------------------------------
# Quando preenchido, o cardapio e o estoque passam a vir do ERP e o pedido do
# delivery vira venda la dentro. Vazio, o Tronvix Facil opera sozinho.
TRONVIX_ERP_URL=
TRONVIX_ERP_TOKEN=

# --- Banco local de teste ----------------------------------------------------
# Usado por `npm run db:test` e `npm run db:tipos`. Nao precisa existir em
# producao.
BANCO_DE_TESTE=tronvix_facil_teste
