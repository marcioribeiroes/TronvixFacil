# Envio para a App Store.
#
# Antes de usar, uma vez só:
#
#   1. App Store Connect > Usuários e Acesso > Integrações > Chaves da API
#      > gerar uma chave com função "App Manager". Baixe o .p8 (só dá para
#      baixar UMA vez) e anote o Key ID e o Issuer ID.
#   2. Guarde o .p8 FORA do repositório e aponte:
#
#        export ASC_KEY_ID=XXXXXXXXXX
#        export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#        export ASC_KEY_P8=~/.chaves/AuthKey_XXXXXXXXXX.p8
#
# Depois:
#
#   fastlane conferir   # valida a chave e diz o que a Apple já conhece
#   ../rodar.sh --build ios --release --no-codesign   # do diretorio ios/
#   fastlane beta       # empacota, assina e sobe para o TestFlight
#   fastlane loja       # sobe a ficha (textos e capturas), sem enviar a revisão
#
# O envio da revisão continua sendo um clique humano no App Store Connect, de
# propósito: `fastlane` que publica sozinho é um acidente esperando o dia em
# que alguém rodar o comando errado.

default_platform(:ios)

APP = "br.com.tronvix.tronvixFacil"

def chave
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_P8")),
    in_house: false,
  )
end

platform :ios do
  desc "Confere se a chave funciona"
  lane :conferir do
    api = chave
    app = Spaceship::ConnectAPI::App.find(APP)
    if app
      UI.success("Chave aceita. O app #{APP} já existe no App Store Connect.")
    else
      UI.important("Chave aceita, mas #{APP} ainda não existe lá. " \
        "Rode `fastlane criar` para registrá-lo.")
    end
    api
  end

  desc "Cria o registro do app no App Store Connect"
  lane :criar do
    chave

    if Spaceship::ConnectAPI::App.find(APP)
      UI.success("O app #{APP} já existe no App Store Connect.")
      next
    end

    # A Apple nao deixa criar app por API: `apps` aceita GET e UPDATE, nunca
    # CREATE. Tentamos, e a resposta dela e literal:
    #
    #   The resource 'apps' does not allow 'CREATE'.
    #
    # Entao esta lane nao cria — ela diz onde criar. E o unico passo do
    # processo que precisa de um navegador, e acontece uma vez na vida do app.
    UI.user_error!(<<~FIM)
      A Apple nao cria app por API. Faca uma vez, no site:

        https://appstoreconnect.apple.com/apps  >  +  >  Novo app

        Plataforma ....... iOS
        Nome ............. Tronvix Facil
        Idioma principal . Portugues (Brasil)
        Pacote ........... #{APP}
        SKU .............. tronvix-facil-br
        Acesso ........... Acesso total

      Depois disso, `fastlane beta` e `fastlane loja` fazem o resto.
    FIM
  end

  desc "Registra o identificador do app no portal de desenvolvedor"
  #
  # O registro do app dentro do App Store Connect — aquele que dá nome, idioma
  # e SKU — a Apple ainda não expõe por API: é o único passo que precisa ser
  # feito no site, em appstoreconnect.apple.com > Apps > +.
  #
  # O identificador, esse sim, sai daqui. Sem ele o Xcode não assina nada.
  lane :identificador do
    # `produce` ainda pede usuário e senha de Apple ID mesmo com a chave de API
    # na mão. O Spaceship, que é o que ele usa por baixo, aceita a chave — e é
    # só isso que precisamos aqui.
    chave

    ja = Spaceship::ConnectAPI::BundleId.find(APP)
    if ja
      UI.success("O identificador #{APP} já estava registrado.")
    else
      Spaceship::ConnectAPI::BundleId.create(
        name: "Tronvix Facil",
        identifier: APP,
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      )
      UI.success("Identificador #{APP} registrado.")
    end
  end

  desc "Empacota, assina e sobe para o TestFlight (rode antes ./rodar.sh --build ios --release --no-codesign)"
  #
  # O Flutter compila FORA do fastlane, pelo `rodar.sh`: e ele que passa as
  # chaves do Supabase (--dart-define). Compilado de dentro do fastlane, o app
  # sairia sem elas — abrindo na tela de "falta configurar" — e o Ruby do
  # fastlane ainda quebra o CocoaPods do `flutter build`.
  #
  # Assinatura manual, de proposito. O Xcode deste Mac nao tem conta logada, e
  # a assinatura "na nuvem" pede uma permissao que a chave de API nao tem. O
  # certificado Apple Distribution do time esta no keychain; o `sigh` cria (ou
  # reaproveita) o perfil da App Store pela API — com o push que o entitlement
  # pede — e o export usa esse perfil.
  lane :beta do
    api = chave
    sigh(api_key: api, app_identifier: APP)
    perfil = lane_context[SharedValues::SIGH_NAME]
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      output_directory: File.expand_path("../../build/ios/fastlane", __dir__),
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP => perfil },
      },
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' " \
        "PROVISIONING_PROFILE_SPECIFIER='#{perfil}'",
    )
    upload_to_testflight(api_key: api, skip_waiting_for_build_processing: true)
  end

  desc "So envia o .ipa ja assinado em build/ios/fastlane (quando o envio falhou depois do build)"
  lane :enviar do
    upload_to_testflight(
      api_key: chave,
      ipa: File.expand_path("../../build/ios/fastlane/Runner.ipa", __dir__),
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Sobe a ficha da loja: textos e capturas"
  lane :loja do
    deliver(
      api_key: chave,
      app_identifier: APP,
      # Nada é enviado para revisão por aqui.
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
